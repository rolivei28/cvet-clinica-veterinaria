{
  "name": "cvet-api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && (test -f .env || cp .env.example .env)",
    "dev": "npx prisma generate && node scripts/init-db.mjs && tsx watch src/index.ts",
    "dev:env": "npx prisma generate && node --env-file=.env scripts/init-db.mjs && tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "db:init": "node scripts/init-db.mjs",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.5.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "pg": "^8.13.1",
    "hono": "^4.7.7",
    "prisma": "^7.7.0",
    "zod": "^3.24.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.0.0-rc.16"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  }
}
